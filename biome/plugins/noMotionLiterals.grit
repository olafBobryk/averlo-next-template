// Motion timing, easing and spring values come from the motion tokens
// (src/components/ui/foundations/motionTiming.ts, spring.ts, library.css).
// Zero is allowed: `{ duration: 0 }` is the instant transition.
language js

pattern nonzero_number() {
	JsNumberLiteralExpression() as $number where { not $number <: r"0*(?:\.0*)?" }
}

pattern motion_number() {
	or {
		nonzero_number(),
		JsUnaryExpression(argument=nonzero_number()),
		JsConditionalExpression(consequent=$yes, alternate=$no) where {
			or { $yes <: nonzero_number(), $no <: nonzero_number() }
		},
		JsLogicalExpression(right=nonzero_number())
	}
}

or {
	JsPropertyObjectMember(name=$key, value=$value) where {
		$key <: r"[\"']?(?:duration|delay|stiffness|damping|mass|bounce|visualDuration|repeatDelay|staggerChildren|delayChildren)[\"']?",
		$value <: motion_number(),
		register_diagnostic(span=$value, message="Motion timing literal: use a motion step from ui/foundations (spring.ts, motionTiming.ts) instead of a numeric duration, delay or spring value.")
	},
	JsPropertyObjectMember(name=$key, value=JsArrayExpression() as $value) where {
		$key <: r"[\"']?ease[\"']?",
		register_diagnostic(span=$value, message="Motion easing literal: use a motion token from ui/foundations instead of a cubic-bezier array.")
	},
	JsxAttribute(name=$key, initializer=JsxAttributeInitializerClause(value=JsxExpressionAttributeValue(expression=$value))) where {
		$key <: r"(?:duration|delay|stiffness|damping|mass|bounce|visualDuration|staggerDelay|ease)",
		$value <: or {
			motion_number(),
			JsArrayExpression()
		},
		register_diagnostic(span=$value, message="Motion timing literal: pass a motion token from ui/foundations instead of a numeric duration, delay, spring or easing value.")
	},
	or {
		JsStringLiteralExpression(),
		JsxString(),
		JsTemplateChunkElement()
	} as $class where {
		$class <: r"(?s).*(?:cubic-bezier\(|(?:^|[\s\"'`:!])(?:duration|delay|ease)-(?:[0-9]|\[[0-9.c])|(?:transition|animation)-duration:\s*[0-9]).*",
		register_diagnostic(span=$class, message="Motion timing literal in a class or style string: use the motion-<step> utilities and --motion-<step>-* tokens from ui/foundations/library.css.")
	}
}
